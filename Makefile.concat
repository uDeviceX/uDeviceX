# Experimental single-translation-unit build.
# The normal object-based build remains available through Makefile.flat.

ROOT := $(abspath .)
BUILD := $(ROOT)/build/concat
GENERATED := $(BUILD)/udx.flat.cu
TARGET := $(BUILD)/udx
GROUP_BUILD := $(BUILD)/groups/$(GROUP)
GROUP_GENERATED := $(GROUP_BUILD)/udx.flat.cu
GROUP_OBJECT := $(GROUP_BUILD)/udx.flat.o

-include $(ROOT)/src/sys.mk
-include $(ROOT)/src/make/common.mk

NVCC ?= nvcc
CCBIN ?= mpicxx
ARCH ?= -arch compute_90 -code sm_90
OPT ?= -O2 -g

CPPFLAGS += -I$(ROOT) -I$(ROOT)/src -I$(ROOT)/src/inc
SOURCE_DIRS := $(sort $(dir $(shell tools/udx-flat plan --root $(ROOT) $(if $(GROUP),--group $(GROUP),))))
CPPFLAGS += $(addprefix -I$(ROOT)/,$(SOURCE_DIRS))
NVCCFLAGS += -std=c++11 $(OPT) -use_fast_math -restrict
# The legacy platform makefiles put GCC driver's -Wl,rpath options in LIBS.
# nvcc is the link driver here and rejects those tokens; the module environment
# already supplies the library paths for the build and test run.
NVCC_LINK_LIBS := $(filter-out -Wl%,$(LIBS))
MPI_LINK_LIBS := $(filter-out -Wl% -pthread,$(shell $(CCBIN) --showme:link 2>/dev/null)) -lopen-rte -lopen-pal

all: $(TARGET)

group:
	@test -n "$(GROUP)" || (echo "set GROUP=<top-level src group>" >&2; exit 2)
	$(MAKE) -f Makefile.concat GROUP=$(GROUP) $(GROUP_OBJECT)

$(GROUP_GENERATED): tools/udx-flat
	tools/udx-flat generate --root $(ROOT) --group $(GROUP) --out $(GROUP_BUILD)

$(GROUP_OBJECT): $(GROUP_GENERATED) | $(GROUP_BUILD)
	$(NVCC) $(ARCH) -ccbin $(CCBIN) $(NVCCFLAGS) $(CPPFLAGS) $(CXXFLAGS) -c $< -o $@

$(GENERATED): tools/udx-flat
	tools/udx-flat generate --root $(ROOT) --out $(BUILD)

$(TARGET): $(GENERATED) | $(BUILD)
	$(NVCC) $(ARCH) -ccbin $(CCBIN) $(NVCCFLAGS) $(CPPFLAGS) $(CXXFLAGS) $(GENERATED) $(NVCC_LINK_LIBS) $(MPI_LINK_LIBS) -lcudart -lcurand -o $@

$(BUILD):
	mkdir -p $@

$(GROUP_BUILD):
	mkdir -p $@

clean:
	rm -rf $(BUILD)

.PHONY: all group clean
