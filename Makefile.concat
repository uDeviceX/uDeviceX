# Build the checked-in single translation unit.

ROOT := $(abspath .)
BUILD := $(ROOT)/build/concat
FLAT := $(ROOT)/udx.flat.cu
TARGET := $(BUILD)/udx

NVCC ?= nvcc
CCBIN ?= mpicxx
ARCH ?= -arch compute_90 -code sm_90
OPT ?= -O2 -g

# Use installed HDF5/NVTX headers when the caller has not supplied paths.
HDF5_ROOT ?= $(firstword $(wildcard /scratch/slitvinov/build/hdf5 /scratch/slitvinov/miniforge3/pkgs/hdf5-*/))
NVTX_INCLUDE ?= $(firstword $(wildcard /usr/local/cuda-*/targets/*/include /scratch/slitvinov/.grace/Linux_aarch64/26.3/cuda/*/targets/sbsa-linux/include))

CPPFLAGS += -I$(ROOT)
CXXFLAGS += ${HDF5_CXXFLAGS} ${MPI_CXXFLAGS} ${LIBCONFIG_CXXFLAGS}
LIBS += ${HDF5_LIBS} ${NVCC_LIBS} ${LIBCONFIG_LIBS} ${MPI_LIBS}
ifneq ($(strip $(HDF5_ROOT)),)
CPPFLAGS += -I$(HDF5_ROOT)/include
LIBS += -L$(HDF5_ROOT)/lib -lhdf5
endif
ifneq ($(strip $(NVTX_INCLUDE)),)
CPPFLAGS += -I$(NVTX_INCLUDE)
endif
NVCCFLAGS += -std=c++11 $(OPT) -use_fast_math -restrict
NVCC_LINK_LIBS := $(filter-out -Wl%,$(LIBS))
MPI_LINK_LIBS := $(filter-out -Wl% -pthread,$(shell $(CCBIN) --showme:link 2>/dev/null)) -lopen-rte -lopen-pal

all: $(TARGET)

$(TARGET): $(FLAT) | $(BUILD)
	$(NVCC) $(ARCH) -ccbin $(CCBIN) $(NVCCFLAGS) $(CPPFLAGS) $(CXXFLAGS) $(FLAT) $(NVCC_LINK_LIBS) $(MPI_LINK_LIBS) -lcudart -lcurand -o $@

$(BUILD):
	mkdir -p $@

clean:
	rm -rf $(BUILD)

.PHONY: all clean
