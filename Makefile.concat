# Build the checked-in single translation unit.

ROOT := $(abspath .)
BUILD := $(ROOT)/build/concat
FLAT := $(ROOT)/udx.flat.cu
TARGET := $(BUILD)/udx

NVCC ?= nvcc
CCBIN ?= mpicxx
ARCH ?= -arch compute_90 -code sm_90
OPT ?= -O2 -g

CPPFLAGS += -I$(ROOT)
CXXFLAGS += ${HDF5_CXXFLAGS} ${MPI_CXXFLAGS} ${LIBCONFIG_CXXFLAGS} ${BOP_CXXFLAGS}
LIBS += ${HDF5_LIBS} ${NVCC_LIBS} ${LIBCONFIG_LIBS} ${BOP_LIBS} ${MPI_LIBS}
NVCCFLAGS += -std=c++11 $(OPT) -use_fast_math -restrict
NVCC_LINK_LIBS := $(filter-out -Wl%,$(LIBS))
MPI_LINK_LIBS := $(filter-out -Wl% -pthread,$(shell $(CCBIN) --showme:link 2>/dev/null)) -lopen-rte -lopen-pal

all: $(TARGET)

$(TARGET): $(FLAT) | $(BUILD)
	$(NVCC) $(ARCH) -ccbin $(CCBIN) $(NVCCFLAGS) $(CPPFLAGS) $(CXXFLAGS) $(FLAT) $(NVCC_LINK_LIBS) $(MPI_LINK_LIBS) -lcudart -lcurand -o $@

$(BUILD):
	mkdir -p $@

clean:
	rm -rf $(BUILD)

.PHONY: all clean
