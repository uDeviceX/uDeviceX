# Conventional single-binary build.
#
# This deliberately excludes src/test and src/u client mains.  The existing
# generated build remains available while this path is validated.

ROOT := $(abspath .)
SRC := $(ROOT)/src
BUILD := $(ROOT)/build/flat
OBJ := $(BUILD)/obj

-include $(SRC)/sys.mk
-include $(SRC)/make/common.mk

CXX ?= mpicxx
LINK ?= $(CXX)
NVCC ?= nvcc
ARCH ?= -arch compute_90 -code sm_90
OPT ?= -O2 -g

CPPFLAGS += -I$(SRC) -I$(OBJ)
COMMON := -std=c++11 $(OPT)
NVCCFLAGS += $(COMMON) -use_fast_math -restrict

# The source tree has many files named imp.cpp/imp.cu.  Keeping the relative
# source path in the object path avoids collisions without renaming sources.
CPP_SRCS := $(shell find $(SRC) -type f -name '*.cpp' \
  ! -path '$(SRC)/test/*' ! -path '$(SRC)/u/*' | sort)
CU_SRCS := $(shell find $(SRC) -type f -name '*.cu' \
  ! -path '$(SRC)/test/*' ! -path '$(SRC)/u/*' | sort)
C_SRCS := $(shell find $(SRC) -type f -name '*.c' \
  ! -path '$(SRC)/test/*' | sort)

CPP_OBJS := $(patsubst $(SRC)/%.cpp,$(OBJ)/%.o,$(CPP_SRCS))
CU_OBJS := $(patsubst $(SRC)/%.cu,$(OBJ)/%.o,$(CU_SRCS))
C_OBJS := $(patsubst $(SRC)/%.c,$(OBJ)/%.o,$(C_SRCS))
OBJS := $(CPP_OBJS) $(CU_OBJS) $(C_OBJS)
DEPS := $(OBJS:.o=.d)

TARGET := $(BUILD)/udx
DEVICE_LINK := $(BUILD)/gpu.o

all: $(TARGET)

$(TARGET): $(OBJS) $(DEVICE_LINK) | $(BUILD)
	$(LINK) $(OBJS) $(DEVICE_LINK) $(LIBS) -lcudart -lcurand -o $@

$(DEVICE_LINK): $(CU_OBJS) | $(BUILD)
	$(NVCC) $(ARCH) -dlink $^ -o $@

$(OBJ)/%.o: $(SRC)/%.cpp
	@mkdir -p $(dir $@)
	$(NVCC) -Wno-deprecated-gpu-targets --compiler-options '$(COMMON) $(CPPFLAGS) $(CXXFLAGS) -I$(dir $<)' -MMD -MP $< -c -o $@

$(OBJ)/%.o: $(SRC)/%.cu
	@mkdir -p $(dir $@)
	$(NVCC) $(ARCH) $(NVCCFLAGS) --compiler-options '$(CPPFLAGS) $(CXXFLAGS) -I$(dir $<)' -MMD -MP $< -c -o $@

$(OBJ)/%.o: $(SRC)/%.c
	@mkdir -p $(dir $@)
	$(CC) $(COMMON) $(CPPFLAGS) $(CFLAGS) -I$(dir $<) -MMD -MP $< -c -o $@

$(BUILD):
	mkdir -p $@

clean:
	rm -rf $(BUILD)

-include $(DEPS)

.PHONY: all clean
