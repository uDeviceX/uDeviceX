#!/bin/sh
# nTEST: grid.raw.t1
set -eu

root=${UDX_ROOT:?UDX_ROOT is not set}
raw_bin=${UDX_RAW_BIN:-$root/build/udx}
test_dir=$(mktemp -d "${TMPDIR:-/tmp}/udx-grid-raw.XXXXXX")
trap 'rm -rf "$test_dir"' EXIT INT TERM

cp "$root/test/mix.contact/2/conf.cfg" "$test_dir/conf.cfg"
cp "$root/test/mix.contact/2/rbc.test.cfg" "$test_dir/rbc.test.cfg"
cp "$root/data/rig/cylinder.ply" "$test_dir/rig.ply"
cp "$root/data/cells/sph/sc/642.off" "$test_dir/rbc.off"
cp "$root/data/cells/rbc/sc/642.off" "$test_dir/ref.off"

cd "$test_dir"
SEED=123 "$root/tools/regression/bin/plcmt.ro" 16 32 16 3.0 0.2 0.5 0.0 rigs-ic.txt rbcs-ic.txt

"$raw_bin" conf.cfg "
glb = { L = [16, 32, 16] }
dump = { field = true freq_field = 0.7500 mesh = false }
sampler = { n_per_dump = 1 grid_ref = [1, 1, 1] }
rbc = { stress_free = true stress_free_file = \"ref.off\" }
"

raw_xmf=$(find raw -maxdepth 1 -name '*.xmf' -type f | sort | head -n 1)
test -n "$raw_xmf"
python3 "$root/tools/raw_grid.py" check "$raw_xmf" > raw.out.txt

if test -n "${UDX_HDF5_BIN:-}"; then
    legacy_dir=$(mktemp -d "${TMPDIR:-/tmp}/udx-grid-h5.XXXXXX")
    trap 'rm -rf "$test_dir" "$legacy_dir"' EXIT INT TERM
    cp conf.cfg rbc.test.cfg rig.ply rbc.off ref.off rigs-ic.txt rbcs-ic.txt "$legacy_dir/"
    (cd "$legacy_dir" && "$UDX_HDF5_BIN" conf.cfg "
glb = { L = [16, 32, 16] }
dump = { field = true freq_field = 0.7500 mesh = false }
sampler = { n_per_dump = 1 grid_ref = [1, 1, 1] }
rbc = { stress_free = true stress_free_file = \"ref.off\" }
")
    legacy_xmf=$(find "$legacy_dir/h5" -maxdepth 1 -name '*.xmf' -type f | sort | head -n 1)
    test -n "$legacy_xmf"
    python3 "$root/tools/raw_grid.py" compare "$raw_xmf" "$legacy_xmf" >/dev/null
elif test -n "${UDX_HDF5_XMF:-}"; then
    python3 "$root/tools/raw_grid.py" compare "$raw_xmf" "$UDX_HDF5_XMF" >/dev/null
fi
