#!/bin/sh
set -eu

root=${UDX_ROOT:?UDX_ROOT is not set}
test_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PATH="$root/pre/placement:$root/tools/regression/bin:$root/tools:$PATH"
export PATH
work=$(mktemp -d "${TMPDIR:-/tmp}/udx-mix-contact.XXXXXX")
trap 'rm -rf "$work"' EXIT INT TERM
cd "$work"
mkdir -p "$work/.udx"
cp "$HOME/.udx/default.cfg" "$work/.udx/default.cfg"
cp "$test_dir/rbc.cfg" "$work/.udx/rbc.cfg"
cp "$test_dir/conf.cfg" .

SEED=123 "$root/tools/regression/bin/pack" 16 32 16 3.0 0.2 0.5 0.0 rigs-ic.txt rbcs-ic.txt
"$root/tools/regression/bin/rigid" cylinder rig.ply
"$root/tools/regression/bin/cell" sph/sc/642 rbc.off
"$root/tools/regression/bin/cell" rbc/sc/642 ref.off

HOME="$work" mpirun -np 2 "$root/build/udx" 2 1 1 -- conf.cfg "$(cat <<'CONFIG'
glb = {
    L = [16, 32, 16]
}
dump = {
    mesh = true
    freq_mesh = 0.7500
    field = true
    freq_field = 0.7500
}
sampler = {
    n_per_dump = 1
    grid_ref = [1, 1, 1]
}
rbc = {
    stress_free      = true
    stress_free_file = "ref.off"
}
CONFIG
)"

raw_xmf=$(find raw -maxdepth 1 -name '*.xmf' -type f | sort | head -n 1)
test -n "$raw_xmf"
python3 "$root/tools/grid.py" check "$raw_xmf" >/dev/null

"$root/tools/ply2punto" ply/rbc/00002.ply |
    awk '{ for (i = 1; i <= NF; i++) printf "%.15g%s", 0.1 * $i, i < NF ? " " : "\n" }' > ply.out.txt
awk -v eps=0.1 '
FNR == NR {
    lines = FNR
    fields[FNR] = NF
    for (i = 1; i <= NF; i++) ref[FNR, i] = $i
    next
}
{
    if (FNR > lines || NF != fields[FNR]) bad = 1
    for (i = 1; i <= NF; i++)
        if ($i != ref[FNR, i] && (($i - ref[FNR, i]) < -eps || ($i - ref[FNR, i]) > eps)) bad = 1
}
END { if (FNR != lines) bad = 1; exit bad }
' "$test_dir/reference.txt" ply.out.txt
