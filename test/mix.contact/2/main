#!/bin/sh
set -eu

root=${UDX_ROOT:?UDX_ROOT is not set}
PATH="$root/pre/placement:$root/tools/regression/bin:$root/tools:$root/tools/atest:$PATH"
export PATH
work=$(mktemp -d "${TMPDIR:-/tmp}/udx-mix-contact.XXXXXX")
trap 'rm -rf "$work"' EXIT INT TERM
cd "$work"
cp "$root/test/mix.contact/2/conf.cfg" "$root/test/mix.contact/2/rbc.test.cfg" .

SEED=123 "$root/tools/regression/bin/plcmt.ro" 16 32 16 3.0 0.2 0.5 0.0 rigs-ic.txt rbcs-ic.txt
"$root/tools/regression/bin/u.cp.rig" cylinder rig.ply
"$root/tools/regression/bin/u.cp.rbc" sph/sc/642 rbc.off
"$root/tools/regression/bin/u.cp.rbc" rbc/sc/642 ref.off

mpirun -np "${UDX_NP:-1}" "$root/build/udx" conf.cfg "$(cat <<'CONFIG'
glb = {
    L = [16, 32, 16]
}
dump = {
    mesh = true
    freq_mesh = 0.7500
    field = true
    freq_field = 0.7500
}
sampler = {
    n_per_dump = 1
    grid_ref = [1, 1, 1]
}
rbc = {
    stress_free      = true
    stress_free_file = "ref.off"
}
CONFIG
)"

raw_xmf=$(find raw -maxdepth 1 -name '*.xmf' -type f | sort | head -n 1)
test -n "$raw_xmf"
python3 "$root/tools/raw_grid.py" check "$raw_xmf" >/dev/null

"$root/tools/ply2punto" ply/rbc/00002.ply | "$root/tools/atest/uscale" 0.1 > ply.out.txt
"$root/tools/atest/ucmp" ply.out.txt "$root/test_data/ply.ref.mix.contact.t2.txt"
