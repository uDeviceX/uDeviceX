#!/usr/bin/env python3
"""Plan and generate uDeviceX's single-translation-unit build input."""

import argparse
import hashlib
import json
import os
import pathlib
import re
import sys
import tempfile


VERSION = "1"
SOURCE_SUFFIXES = {".c", ".cpp", ".cu"}
MAIN_RE = re.compile(r"\bmain\s*\(")


def fail(message):
    print(f"udx-flat: error: {message}", file=sys.stderr)
    return 2


def source_files(root):
    src = root / "src"
    if not src.is_dir():
        raise ValueError(f"missing source directory: {src}")
    paths = []
    for path in src.rglob("*"):
        if not path.is_file() or path.suffix not in SOURCE_SUFFIXES:
            continue
        rel = path.relative_to(root)
        parts = rel.parts
        if "test" in parts or "u" in parts:
            continue
        resolved = path.resolve()
        if root not in resolved.parents and resolved != root:
            raise ValueError(f"source symlink escapes repository: {rel}")
        paths.append((rel.as_posix(), path))
    paths.sort(key=lambda item: (item[0] == "src/main.cpp", item[0]))
    if not any(rel == "src/main.cpp" for rel, _ in paths):
        raise ValueError("missing entry point src/main.cpp")
    return paths


def validate(paths):
    mains = []
    for rel, path in paths:
        try:
            text = path.read_text(encoding="utf-8")
        except UnicodeDecodeError as exc:
            raise ValueError(f"cannot read {rel} as UTF-8: {exc}") from exc
        if MAIN_RE.search(text):
            mains.append(rel)
    if mains != ["src/main.cpp"]:
        raise ValueError("multiple main functions found: " + ", ".join(mains))


def manifest(root, paths):
    sources = []
    for rel, path in paths:
        digest = hashlib.sha256(path.read_bytes()).hexdigest()
        sources.append({"path": rel, "sha256": digest})
    return {"tool_version": VERSION, "sources": sources}


def generated_text(manifest_data):
    digest = hashlib.sha256(
        json.dumps(manifest_data, sort_keys=True, separators=(",", ":")).encode()
    ).hexdigest()
    lines = [
        "// generated by tools/udx-flat; do not edit",
        f"// tool-version: {VERSION}",
        f"// manifest-sha256: {digest}",
        "",
    ]
    for item in manifest_data["sources"]:
        path = item["path"]
        lines.extend([
            f'#line 1 "{path}"',
            f'#include "{path}"',
            "",
        ])
    return "\n".join(lines)


def atomic_write(path, content, binary=False):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        mode = "wb" if binary else "w"
        with os.fdopen(fd, mode, encoding=None if binary else "utf-8", newline="\n") as stream:
            stream.write(content)
        os.replace(temporary, path)
    except Exception:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
        raise


def command(args):
    root = pathlib.Path(args.root).resolve()
    try:
        paths = source_files(root)
        validate(paths)
    except ValueError as exc:
        return fail(str(exc))

    data = manifest(root, paths)
    if args.command == "plan":
        print("\n".join(item["path"] for item in data["sources"]))
        return 0
    if args.command == "generate":
        out = pathlib.Path(args.out).resolve()
        try:
            atomic_write(out / "udx.flat.cu", generated_text(data))
            atomic_write(out / "manifest.json", json.dumps(data, indent=2) + "\n")
        except OSError as exc:
            return fail(str(exc))
        print(out / "udx.flat.cu")
        return 0
    return fail(f"unknown command: {args.command}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)
    for name in ("plan", "generate"):
        sub = subparsers.add_parser(name)
        sub.add_argument("--root", default=".")
        if name == "generate":
            sub.add_argument("--out", default="build/flat")
        sub.set_defaults(func=command)
    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
