#!/bin/sh
set -eu

root=${UDX_ROOT:?UDX_ROOT is not set}
D="${D:-$root/data}"
test $# -eq 2 || { echo 'cell: needs source and destination' >&2; exit 2; }
f=$1
t=$2
for p in "$D/cells/$f" "$D/cells/$f.off"; do
    if test -f "$p"; then exec cp "$p" "$t"; fi
done
echo "cell: cannot find cell '$f'" >&2
exit 2
